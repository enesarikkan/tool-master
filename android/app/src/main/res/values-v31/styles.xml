<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#F4F2EC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F4F2EC</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">#F4F2EC</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F4F2EC</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
